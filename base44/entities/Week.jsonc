{
  "name": "Week",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string",
      "description": "Parent course ID"
    },
    "week_number": {
      "type": "number",
      "description": "Week number (1, 2, 3...)"
    },
    "title_en": {
      "type": "string",
      "description": "Week title in English"
    },
    "title_es": {
      "type": "string",
      "description": "Week title in Spanish"
    },
    "title_ps": {
      "type": "string",
      "description": "Week title in Pashtu"
    },
    "title_fa": {
      "type": "string",
      "description": "Week title in Persian"
    },
    "title_km": {
      "type": "string",
      "description": "Week title in Khmer"
    },
    "overview_en": {
      "type": "string",
      "description": "Week overview/introduction in English"
    },
    "overview_es": {
      "type": "string",
      "description": "Week overview/introduction in Spanish"
    },
    "overview_ps": {
      "type": "string",
      "description": "Week overview/introduction in Pashtu"
    },
    "overview_fa": {
      "type": "string",
      "description": "Week overview/introduction in Persian"
    },
    "overview_km": {
      "type": "string",
      "description": "Week overview/introduction in Khmer"
    },
    "content_blocks_en": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "video",
              "image",
              "richtext",
              "audio"
            ]
          },
          "content": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        }
      },
      "description": "Flexible content blocks for English"
    },
    "content_blocks_es": {
      "type": "array",
      "items": {
        "type": "object",
