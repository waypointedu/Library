      "type": "boolean",
      "default": false,
      "description": "Whether this week has a quiz"
    },
    "has_discussion": {
      "type": "boolean",
      "default": false,
      "description": "Whether this week has a discussion forum"
    },
    "has_written_assignment": {
      "type": "boolean",
      "default": false,
      "description": "Whether this week has a written assignment"
    },
    "video_url": {
      "type": "string",
      "description": "Optional video URL (legacy)"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "description": "File attachments"
    }
  },
  "required": [
    "course_id",
    "week_number",
    "title_en"
  ]
}