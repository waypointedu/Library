      "description": "Reading assignment in Pashtu"
    },
    "reading_assignment_fa": {
      "type": "string",
      "description": "Reading assignment in Persian"
    },
    "reading_assignment_km": {
      "type": "string",
      "description": "Reading assignment in Khmer"
