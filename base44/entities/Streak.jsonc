{
  "name": "Streak",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User tracking streak"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Current consecutive days"
    },
    "longest_streak": {
      "type": "number",
      "default": 0,
      "description": "Best streak ever"
    },
    "last_activity_date": {
      "type": "string",
      "format": "date",
      "description": "Last day user was active"
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "Total gamification points"
    }
  },
  "required": [
    "user_email"
  ]
}