{
  "name": "PeerEndorsement",
  "type": "object",
  "properties": {
    "endorsed_user_email": {
      "type": "string",
      "description": "User being endorsed"
    },
    "endorsement_type": {
      "type": "string",
      "enum": [
        "helpful_discussion",
        "encouraging_word",
        "insightful_comment",
        "prayerful_support",
        "excellent_capstone"
      ],
      "description": "Type of endorsement"
    },
    "course_id": {
      "type": "string",
      "description": "Course context (optional)"
    },
    "anonymous": {
      "type": "boolean",
      "default": true,
      "description": "All endorsements are anonymous"
    }
  },
  "required": [
    "endorsed_user_email",
    "endorsement_type"
  ]
}